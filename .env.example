# Copy this file to ".env" and fill in the values. Never commit .env to GitHub.

# Contact form: get a free access key at https://web3forms.com using the CLIENT's email
NUXT_PUBLIC_WEB3FORMS_KEY=

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX), from the client's GA account
NUXT_PUBLIC_GA_ID=

# The live website address (used for SEO)
NUXT_PUBLIC_SITE_URL=https://www.example.com
NUXT_PUBLIC_SITE_NAME=Agency Name
